DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/caps_tutor
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# ADR-043: SMS for parent sign-up. Leave empty in development (codes go to the log).
# Production: the provider name once one is implemented in app/services/sms.py.
SMS_PROVIDER=

# ADR-045: tutor questions per learner per day (0 = no limit)
TUTOR_DAILY_LIMIT=60

# --- deep scan 20 Nov 2026 (ADR-048) ---------------------------------------
# Database connections per API instance (see docs/RUNBOOK.md before raising).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Uploads per learner per day.
UPLOAD_DAILY_LIMIT=30
# Optional second model used once if the main one is overloaded; empty = none.
FALLBACK_MODEL=
# "json" on Cloud Run (one JSON object per log line); "text" locally.
LOG_FORMAT=text
# Days to keep records; 0 = keep until periods are agreed with schools.
# Applied by: python -m scripts.retention   (run nightly)
RETENTION_CONVERSATION_DAYS=0
RETENTION_UPLOAD_DAYS=0
RETENTION_AUDIT_DAYS=0
# In production JWT_SECRET_KEY must be at least 32 random characters. Make one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- topic video narration (ADR-049) -----------------------------------------
# Only for scripts/topic_videos/voice.py on your own machine. Azure portal ->
# create a "Speech" resource (Free F0 tier) -> Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
# ... or Amazon Polly (scripts/topic_videos/voice.py --engine polly).
# An IAM user with only the AmazonPollyReadOnlyAccess policy -> Access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- support (ADR-050) -------------------------------------------------------
# Shown in the Help Centre and on the login page.
SUPPORT_EMAIL=support@zynoratech.co.za
SUPPORT_WHATSAPP=+27 67 590 1165
SUPPORT_HOURS=06:00-18:00 (SAST)
# Email alerts for new tickets and replies (the support mailbox's SMTP
# details from your email host). Empty SMTP_HOST = alerts go to the log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=THUTOra Support <support@zynoratech.co.za>
# Days to keep resolved tickets; 0 = keep.
RETENTION_SUPPORT_DAYS=0
