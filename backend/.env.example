DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/caps_tutor
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# ADR-043: SMS for parent sign-up. Leave empty in development (codes go to the log).
# Production: the provider name once one is implemented in app/services/sms.py.
SMS_PROVIDER=

# ADR-045: tutor questions per learner per day (0 = no limit)
TUTOR_DAILY_LIMIT=60
